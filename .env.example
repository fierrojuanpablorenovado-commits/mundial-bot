# ─────────────────────────────────────────────────────────────────────
# mundial-bot — variables de entorno
# Duplicar en GitHub Secrets del repo fierrojuanpablorenovado-commits/mundial-bot
# ─────────────────────────────────────────────────────────────────────

# PlayDoit (misma cuenta que playdoit-bot)
PLAYDOIT_USER=
PLAYDOIT_PASS=
PROXY_URL=

# OpenAI (veto cualitativo + web_search noticias)
OPENAI_API_KEY=

# Football data (free tiers)
FOOTBALL_DATA_API_KEY=d3715dcadaea431fb77b5db78368c7cb
API_SPORTS_KEY=e222002d939acd3fc435ed88a18e6d12

# ── NOTIFICACIONES ──
# KILL-SWITCH: false = el bot corre pero NO envía nada (solo loguea).
# Encender solo cuando JP confirme canal + horario + formato finales.
NOTIFICATIONS_ENABLED=false

# Canal: telegram / callmebot / stdout. Default telegram.
CHANNEL=telegram

# Telegram (si CHANNEL=telegram). Crear bot en @BotFather, /newbot.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# CallMeBot (NO usar en mundial-bot — es exclusivo del playdoit-bot).
# Estas vars existen solo por compatibilidad, dejarlas vacías.
CALLMEBOT_PHONE=
CALLMEBOT_APIKEY=

# Bankroll y modo
BANKROLL_INITIAL=1000
DRY_RUN=true
KELLY_DIV=5
EDGE_MIN_PCT=6
EDGE_MAX_PCT=35
MAX_PICKS_PER_DAY=3
SESSION_BUDGET_PCT=25
STOP_LOSS_PCT=30
SOFT_PAUSE_PCT=15
